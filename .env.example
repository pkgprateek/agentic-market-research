# Environment Configuration
# Copy this to .env and fill in your API keys

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════════════════

# --- LLM Provider ---
# Option 1: Groq (fast, free tier available)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option 2: OpenRouter (400+ models, add later)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Search API ---
# Tavily (AI-native search for agents)
# Get key: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ═══════════════════════════════════════════════════════════════════════════
# MODEL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Default model to use
# Groq models (use with GROQ_API_KEY):
DEFAULT_MODEL=llama-3.3-70b-versatile
# Other Groq options: llama-3.1-8b-instant, mixtral-8x7b-32768

# OpenRouter models (use with OPENROUTER_API_KEY):
# DEFAULT_MODEL=x-ai/grok-3-fast:free
# DEFAULT_MODEL=anthropic/claude-sonnet-4
# DEFAULT_MODEL=openai/gpt-4.1-mini

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════════════════════

# --- Observability (LangSmith) ---
# Sign up: https://smith.langchain.com (free tier: 5K traces/month)
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGCHAIN_TRACING=true
# LANGCHAIN_PROJECT=market-intelligence

# --- Cost Limits ---
MAX_COST_PER_RUN=2.0

# --- Environment ---
ENVIRONMENT=development